<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fundo_basquete"
    android:fitsSystemWindows="true"
    tools:context=".BasqueteActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Time A -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/timeA"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/transparent_black"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:padding="@dimen/basquete_team_padding"
                    android:text="@string/basquete_time_a"
                    android:textColor="@color/basquete_team_a"
                    android:textSize="@dimen/text_sm" />

                <TextView
                    android:id="@+id/placarTimeA"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:padding="@dimen/spacing_xs"
                    android:text="@string/basquete_placar_inicial"
                    android:textColor="@color/basquete_score_text"
                    android:textSize="@dimen/text_display_lg" />

                <Button
                    android:id="@+id/tresPontosA"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/basquete_btn_margin"
                    android:background="@color/basquete_team_a"
                    android:text="@string/basquete_btn_tres"
                    android:textColor="@color/white" />

                <Button
                    android:id="@+id/doisPontosA"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/basquete_btn_margin"
                    android:background="@color/basquete_team_a"
                    android:text="@string/basquete_btn_dois"
                    android:textColor="@color/white" />

                <Button
                    android:id="@+id/tiroLivreA"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/basquete_btn_margin"
                    android:background="@color/basquete_team_a"
                    android:text="@string/basquete_btn_livre"
                    android:textColor="@color/white" />

            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/basquete_divider"
                android:layout_marginTop="@dimen/basquete_divider_margin_top" />

            <!-- Time B -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/timeB"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/transparent_black"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:padding="@dimen/basquete_team_padding"
                    android:text="@string/basquete_time_b"
                    android:textColor="@color/basquete_team_b"
                    android:textSize="@dimen/text_sm" />

                <TextView
                    android:id="@+id/placarTimeB"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:padding="@dimen/spacing_xs"
                    android:text="@string/basquete_placar_inicial"
                    android:textColor="@color/basquete_score_text"
                    android:textSize="@dimen/text_display_lg" />

                <Button
                    android:id="@+id/tresPontosB"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/basquete_btn_margin"
                    android:background="@color/basquete_team_b"
                    android:text="@string/basquete_btn_tres"
                    android:textColor="@color/white" />

                <Button
                    android:id="@+id/doisPontosB"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/basquete_btn_margin"
                    android:background="@color/basquete_team_b"
                    android:text="@string/basquete_btn_dois"
                    android:textColor="@color/white" />

                <Button
                    android:id="@+id/tiroLivreB"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/basquete_btn_margin"
                    android:background="@color/basquete_team_b"
                    android:text="@string/basquete_btn_livre"
                    android:textColor="@color/white" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/diferencaPlacar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="@dimen/spacing_md"
            android:text="@string/basquete_empate"
            android:textSize="@dimen/text_lg"
            android:textColor="@color/basquete_diff_text"
            android:textStyle="bold"
            android:layout_marginTop="@dimen/basquete_diferenca_margin_top"
            android:fontFamily="sans-serif" />

        <TextView
            android:id="@+id/quartoAtual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="@dimen/spacing_sm"
            android:text="@string/basquete_quarto_inicial"
            android:textSize="@dimen/text_xl"
            android:textColor="@color/basquete_quarter_text"
            android:textStyle="bold"
            android:fontFamily="sans-serif" />

        <TextView
            android:id="@+id/historicoQuartos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="@dimen/spacing_sm"
            android:textSize="@dimen/text_sm"
            android:textColor="@color/basquete_history_text"
            android:fontFamily="sans-serif" />

        <Button
            android:id="@+id/desfazerPonto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/basquete_btn_margin"
            android:text="@string/basquete_btn_desfazer"
            android:backgroundTint="@color/basquete_undo" />

        <Button
            android:id="@+id/btnVoltarCentral"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_margin="@dimen/basquete_btn_margin"
            android:text="@string/btn_voltar_central" />

        <Button
            android:id="@+id/encerrarQuarto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_margin="@dimen/basquete_btn_margin"
            android:padding="15dp"
            android:shadowRadius="10"
            android:text="@string/basquete_btn_encerrar" />

    </LinearLayout>

    <Button
        android:id="@+id/reiniciarPartida"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_margin="@dimen/basquete_reiniciar_margin"
        android:background="@drawable/botao_reiniciar"
        android:text="@string/basquete_btn_reiniciar" />

</RelativeLayout>