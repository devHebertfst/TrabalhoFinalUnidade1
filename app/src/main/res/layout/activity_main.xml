<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hub_bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/hub_padding">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/hub_title"
            android:textColor="@color/hub_text_primary"
            android:textSize="@dimen/text_display_sm"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:gravity="center"
            android:text="@string/hub_subtitle"
            android:textColor="@color/hub_text_secondary"
            android:textSize="@dimen/text_md" />

        <Button
            android:id="@+id/btnAbrirBasquete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/hub_btn_first_margin_top"
            android:text="@string/hub_btn_basquete" />

        <Button
            android:id="@+id/btnAbrirCalculadora"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/hub_btn_margin_top"
            android:text="@string/hub_btn_calculadora" />

        <Button
            android:id="@+id/btnAbrirQuiz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/hub_btn_margin_top"
            android:text="@string/hub_btn_quiz" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/btnAlternarTema"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Alternar tema"
        android:src="@drawable/ic_dark_mode"
        app:tint="@color/hub_text_primary" />

</FrameLayout>