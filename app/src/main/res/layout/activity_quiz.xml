<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF7E8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/txtCategoriaQuiz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFB347"
            android:gravity="center"
            android:padding="14dp"
            android:text="Categorias: Geografia"
            android:textColor="#3B2200"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtProgressoQuiz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Pergunta 1 de 3"
            android:textColor="#6B4B1F" />

        <ProgressBar
            android:id="@+id/txtProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/txtPontuacaoQuiz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Pontuacao: 0"
            android:textColor="#6B4B1F" />

        <TextView
            android:id="@+id/textTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Time" />

        <TextView
            android:id="@+id/txtPerguntaQuiz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#FFFFFBF2"
            android:gravity="center"
            android:minHeight="140dp"
            android:padding="20dp"
            android:text="Pergunta do quiz"
            android:textColor="#2F1B05"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtStatusQuiz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Selecione uma alternativa"
            android:textColor="#8A3B12"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnOpcao1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="#E07A1F"
            android:text="Opcao 1" />

        <Button
            android:id="@+id/btnOpcao2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="#E07A1F"
            android:text="Opcao 2" />

        <Button
            android:id="@+id/btnOpcao3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="#E07A1F"
            android:text="Opcao 3" />

        <Button
            android:id="@+id/btnOpcao4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="#E07A1F"
            android:text="Opcao 4" />

        <Button
            android:id="@+id/btnProximaPergunta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="#8C6239"
            android:text="Proxima pergunta" />

        <Button
            android:id="@+id/btnReiniciarQuiz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="#A66C2C"
            android:text="Reiniciar quiz" />

        <Button
            android:id="@+id/btnVoltarCentralQuiz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="#5E4323"
            android:text="Voltar para central" />

    </LinearLayout>
</ScrollView>
